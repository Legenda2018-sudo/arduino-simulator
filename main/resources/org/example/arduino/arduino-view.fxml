<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.Canvas?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.arduino.ArduinoController">
    
    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🔌 Симулятор Arduino" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="userLabel" text="Пользователь: гость" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;"/>

                <!-- Поля авторизации для гостя -->
                <HBox spacing="5" alignment="CENTER_RIGHT" fx:id="authBox">
                    <TextField fx:id="loginEmailField"
                              promptText="Email"
                              minWidth="120"
                              prefWidth="160"
                              maxWidth="200"/>
                    <PasswordField fx:id="loginPasswordField"
                                   promptText="Пароль"
                                   minWidth="100"
                                   prefWidth="130"
                                   maxWidth="160"/>
                    <Button text="Войти"
                            fx:id="btnLogin"
                            onAction="#onLoginClick"
                            style="-fx-background-color: #16a085; -fx-text-fill: white;"/>
                    <Button text="Регистрация"
                            fx:id="btnRegister"
                            onAction="#onRegisterClick"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
                    <Button text="Выйти"
                            fx:id="btnLogout"
                            onAction="#onLogoutClick"
                            visible="false"
                            managed="false"
                            style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
                </HBox>

                <!-- Поля названия схемы и сохранения (для вошедшего пользователя) -->
                <HBox spacing="5" alignment="CENTER_RIGHT" fx:id="circuitBox">
                    <TextField fx:id="circuitNameField"
                               promptText="Название схемы"
                               minWidth="120"
                               prefWidth="180"
                               maxWidth="220"/>
                    <Button text="💾 Сохранить"
                            fx:id="btnSave"
                            onAction="#onSaveClick"
                            style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                    <Button text="📂 Загрузить"
                            fx:id="btnLoad"
                            onAction="#onLoadClick"
                            style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                    <Button text="🗑 Удалить схему"
                            fx:id="btnDeleteCircuit"
                            onAction="#onDeleteCircuitClick"
                            style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
                </HBox>
                
                <!-- Кнопка очистки - видна всегда -->
                <Button text="🗑️ Очистить"
                        fx:id="btnClear"
                        onAction="#onClearClick"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </HBox>
            <Label fx:id="statusLabel" text="Статус: Готов к работе" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;"/>
        </VBox>
    </top>
    
    <left>
        <VBox spacing="10" style="-fx-background-color: #34495e;" prefWidth="220">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="📦 Компоненты" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Button text="💡 LED" fx:id="btnLED" prefWidth="200" onAction="#onLEDClick" style="-fx-background-color: #95a5a6;"/>
            <Button text="🔘 Кнопка" fx:id="btnButton" prefWidth="200" onAction="#onButtonClick" style="-fx-background-color: #95a5a6;"/>
            <Button text="⚡ Резистор" fx:id="btnResistor" prefWidth="200" onAction="#onResistorClick" style="-fx-background-color: #95a5a6;"/>
            <Button text="🔷 Arduino UNO" fx:id="btnArduino" prefWidth="200" onAction="#onArduinoClick" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            <Button text="⏱️ Таймер" fx:id="btnTimer" prefWidth="200" onAction="#onTimerClick" style="-fx-background-color: #9b59b6; -fx-text-fill: white;"/>
            
            <Separator/>
            
            <Label text="🔧 Инструменты" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Button text="🔗 Соединить" fx:id="btnConnect" prefWidth="200" onAction="#onConnectClick" style="-fx-background-color: #9b59b6; -fx-text-fill: white;"/>
            <Button text="❌ Удалить" fx:id="btnDelete" prefWidth="200" onAction="#onDeleteClick" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            <Button text="▶️ Запустить симуляцию" fx:id="btnSimulate" prefWidth="200" onAction="#onSimulateClick" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
            
            <Separator/>
            
            <Label text="💾 Сохраненные схемы" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <ListView fx:id="circuitList" prefHeight="200" style="-fx-background-color: #ecf0f1;"/>
            
            <VBox spacing="5" style="-fx-background-color: #1abc9c; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="ℹ️ Инструкция:" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="1. Выберите компонент" style="-fx-text-fill: white; -fx-font-size: 11px;"/>
                <Label text="2. Кликните на плату" style="-fx-text-fill: white; -fx-font-size: 11px;"/>
                <Label text="3. Соедините компоненты" style="-fx-text-fill: white; -fx-font-size: 11px;"/>
                <Label text="4. Запустите симуляцию" style="-fx-text-fill: white; -fx-font-size: 11px;"/>
                <Label text="5. Кликайте по кнопкам" style="-fx-text-fill: white; -fx-font-size: 11px;"/>
            </VBox>
        </VBox>
    </left>
    
    <center>
        <VBox spacing="0" alignment="CENTER">
            <StackPane fx:id="boardStack" style="-fx-background-color: #ecf0f1; -fx-padding: 10;" minWidth="1000" maxWidth="1000" minHeight="750" maxHeight="750">
                <Canvas fx:id="breadboardCanvas" width="1000" height="750" mouseTransparent="true"/>
                <Pane fx:id="wirePane" mouseTransparent="true" prefWidth="1000" prefHeight="750"/>
                <Pane fx:id="componentPane" prefWidth="1000" prefHeight="750" onMouseClicked="#onBreadboardClick" onMouseMoved="#onBreadboardMouseMoved" pickOnBounds="true"/>
            </StackPane>
        </VBox>
    </center>
    
</BorderPane>

